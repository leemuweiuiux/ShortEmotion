{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/short-emotion.js": {
      "maxDuration": 60
    },
    "api/technical-analysis.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {"source": "/", "destination": "/about", "permanent": false},
    {"source": "/shortemotion", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/shortemotion/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/cn", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/cn/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/tw", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/tw/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/cn-short-emotion", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/cn-short-emotion/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/tw-short-emotion", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/tw-short-emotion/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/short-emotion", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/short-emotion/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/shortemotion/tw", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/shortemotion/tw/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/shortemotion/hk", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/shortemotion/hk/", "destination": "/shortemotion/cn", "permanent": false}
  ],
  "rewrites": [
    {"source": "/about", "destination": "/about/index.html"},
    {"source": "/about/", "destination": "/about/index.html"},
    {"source": "/login", "destination": "/login/index.html"},
    {"source": "/login/", "destination": "/login/index.html"},
    {"source": "/account", "destination": "/account/index.html"},
    {"source": "/account/", "destination": "/account/index.html"},
    {"source": "/account/edit", "destination": "/account/edit/index.html"},
    {"source": "/account/edit/", "destination": "/account/edit/index.html"},
    {"source": "/account/points", "destination": "/account/points/index.html"},
    {"source": "/account/points/", "destination": "/account/points/index.html"},
    {"source": "/admin", "destination": "/admin/index.html"},
    {"source": "/admin/", "destination": "/admin/index.html"},
    {"source": "/account/invite", "destination": "/account/invite/index.html"},
    {"source": "/account/invite/", "destination": "/account/invite/index.html"},
    {"source": "/home", "destination": "/home/index.html"},
    {"source": "/home/", "destination": "/home/index.html"},
    {"source": "/technicalanalysis", "destination": "/technical-analysis/index.html"},
    {"source": "/technicalanalysis/", "destination": "/technical-analysis/index.html"},
    {"source": "/shortemotion/cn", "destination": "/short-emotion/index.html"},
    {"source": "/shortemotion/cn/", "destination": "/short-emotion/index.html"}
  ]
}
