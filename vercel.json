{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/short-emotion.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {"source": "/", "destination": "/about", "permanent": false},
    {"source": "/home", "destination": "/about", "permanent": false},
    {"source": "/home/", "destination": "/about", "permanent": false},
    {"source": "/shortemotion", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/shortemotion/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/cn", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/cn/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/tw", "destination": "/shortemotion/tw", "permanent": false},
    {"source": "/tw/", "destination": "/shortemotion/tw", "permanent": false},
    {"source": "/cn-short-emotion", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/cn-short-emotion/", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/tw-short-emotion", "destination": "/shortemotion/tw", "permanent": false},
    {"source": "/tw-short-emotion/", "destination": "/shortemotion/tw", "permanent": false},
    {"source": "/short-emotion", "destination": "/shortemotion/cn", "permanent": false},
    {"source": "/short-emotion/", "destination": "/shortemotion/cn", "permanent": false}
  ],
  "rewrites": [
    {"source": "/about", "destination": "/about/index.html"},
    {"source": "/about/", "destination": "/about/index.html"},
    {"source": "/login", "destination": "/login/index.html"},
    {"source": "/login/", "destination": "/login/index.html"},
    {"source": "/account", "destination": "/account/index.html"},
    {"source": "/account/", "destination": "/account/index.html"},
    {"source": "/shortemotion/cn", "destination": "/short-emotion/index.html"},
    {"source": "/shortemotion/cn/", "destination": "/short-emotion/index.html"},
    {"source": "/shortemotion/hk", "destination": "/short-emotion/index.html"},
    {"source": "/shortemotion/hk/", "destination": "/short-emotion/index.html"},
    {"source": "/shortemotion/tw", "destination": "/short-emotion/index.html"},
    {"source": "/shortemotion/tw/", "destination": "/short-emotion/index.html"}
  ]
}
